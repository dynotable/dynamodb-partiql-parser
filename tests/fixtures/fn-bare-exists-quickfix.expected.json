{
  "source": "https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/ql-functions.html",
  "rules": ["fn-bare-exists-quickfix"],
  "expect": [
    {
      "code": "partiql-unsupported",
      "messageIncludes": "attribute_exists",
      "severity": "error"
    }
  ],
  "quickFix": {
    "label": "Use attribute_exists",
    "applied": "SELECT * FROM t WHERE attribute_exists(x)"
  }
}
